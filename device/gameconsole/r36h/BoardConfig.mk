# SPDX-License-Identifier: Apache-2.0
# Native RK3326 target. No generic GSI BoardConfig or external vendor image.
TARGET_ARCH := arm64
TARGET_ARCH_VARIANT := armv8-a
# This Android 13 Soong branch has no cortex-a35 CPU variant. The RK3326
# implements the ARMv8-A baseline selected here for both userspace ABIs.
TARGET_CPU_VARIANT := generic
TARGET_CPU_ABI := arm64-v8a
TARGET_2ND_ARCH := arm
TARGET_2ND_ARCH_VARIANT := armv8-a
TARGET_2ND_CPU_VARIANT := generic
TARGET_2ND_CPU_ABI := armeabi-v7a
TARGET_2ND_CPU_ABI2 := armeabi
TARGET_USES_64_BIT_BINDER := true
TARGET_BOARD_PLATFORM := rk3326
TARGET_BOARD_HARDWARE := r36h
TARGET_BOOTLOADER_BOARD_NAME := r36h
TARGET_NO_BOOTLOADER := true
TARGET_NO_RECOVERY := true
TARGET_NO_KERNEL := false
TARGET_PREBUILT_KERNEL := $(R36H_NATIVE_KERNEL)
BOARD_KERNEL_IMAGE_NAME := Image
BOARD_BOOTIMAGE_PARTITION_SIZE := 67108864
BOARD_KERNEL_PAGESIZE := 2048
BOARD_KERNEL_BASE := 0x00000000
BOARD_KERNEL_CMDLINE := init=/init rootwait androidboot.hardware=r36h androidboot.selinux=permissive
BOARD_BUILD_SYSTEM_ROOT_IMAGE := false
BOARD_AVB_ENABLE := false
BOARD_FLASH_BLOCK_SIZE := 4096
TARGET_USERIMAGES_USE_EXT4 := true
TARGET_USERIMAGES_SPARSE_EXT_DISABLED := true
BOARD_SYSTEMIMAGE_FILE_SYSTEM_TYPE := ext4
BOARD_SYSTEMIMAGE_PARTITION_RESERVED_SIZE := 134217728
BOARD_VENDORIMAGE_FILE_SYSTEM_TYPE := ext4
BOARD_VENDORIMAGE_PARTITION_SIZE := 536870912
BOARD_USERDATAIMAGE_FILE_SYSTEM_TYPE := ext4
BOARD_USERDATAIMAGE_PARTITION_SIZE := 8589934592
TARGET_COPY_OUT_VENDOR := vendor
TARGET_COPY_OUT_PRODUCT := system/product
TARGET_COPY_OUT_SYSTEM_EXT := system/system_ext
BOARD_VNDK_VERSION := current
BOARD_PROPERTY_OVERRIDES_SPLIT_ENABLED := true
DEVICE_MANIFEST_FILE := device/gameconsole/r36h/manifest.xml
DEVICE_FRAMEWORK_COMPATIBILITY_MATRIX_FILE := device/gameconsole/r36h/framework_compatibility_matrix.xml
USE_XML_AUDIO_POLICY_CONF := 1
BOARD_USES_GENERIC_AUDIO := false
TARGET_USES_HWC2 := true
USE_OPENGL_RENDERER := true
TARGET_BOARD_PLATFORM_GPU := mali-tDVx
TARGET_RK_GRALLOC_VERSION := 4
GRALLOC_HWC_FB_DISABLE_AFBC := 1
GRALLOC_ARM_NO_EXTERNAL_AFBC := 1
include hardware/rockchip/libgralloc/bifrost/gralloc.device.mk
BOARD_HAVE_BLUETOOTH := false
BOARD_WLAN_DEVICE :=
WIFI_DRIVER_MODULE_PATH :=
BOARD_SEPOLICY_DIRS += device/gameconsole/r36h/sepolicy
