// SPDX-License-Identifier: Apache-2.0
// Upstream GammaOS/Rockchip BusyBox is static ARM32, including in this folder.
// Source checkout pin: port/r36h/SOURCES.json. Requires kernel CONFIG_COMPAT.
cc_prebuilt_binary {
    name: "r36h_busybox",
    srcs: ["busybox"],
    stem: "busybox",
    compile_multilib: "32",
    static_executable: true,
    stl: "none",
    strip: { none: true },
    check_elf_files: false,
}
